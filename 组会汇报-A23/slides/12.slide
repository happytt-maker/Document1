<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 34, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>模块二：一份文档，三条提取线，一个库</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>画像、实体、字段各走各的路径，跑完自动落进 MySQL —— 提取不是终点，入库才是</Text>
    </Box>

    {/* 三条线示意 */}
    <Box style={{ position: 'absolute', top: 122, left: 40, width: 1200 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'stretch', gap: 0 }}>
            {/* 文档 */}
            <Box style={{ width: 200, background: '#0E3F8C', padding: '18px 18px', justifyContent: 'center' }}>
                <Text style={{ fontSize: 13, color: '#A9C2E8' }}>输入</Text>
                <Text style={{ fontSize: 20, color: '#FFFFFF', fontWeight: 'bold', marginTop: 6 }}>非结构化文档</Text>
                <Text style={{ fontSize: 13, color: '#D5E2F5', marginTop: 6 }}>docx / xlsx / md / txt</Text>
            </Box>

            <Box style={{ width: 34, justifyContent: 'center', alignItems: 'center' }}>
                <svg width={34} height={18} viewBox='0 0 34 18'><line x1='0' y1='9' x2='24' y2='9' stroke='#8B97A8' strokeWidth='2' /><path d='M24 3 L33 9 L24 15 Z' fill='#8B97A8' /></svg>
            </Box>

            {/* 三线 */}
            <Box style={{ flex: 1, gap: 10 }}>
                <Box style={{ background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '10px 16px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                    <Box>
                        <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>画像线</Text>
                        <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 2 }}>主题 + 3~7 条要点 + 关键要素</Text>
                    </Box>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>「提取 XX 的关键信息」</Text>
                </Box>
                <Box style={{ background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '10px 16px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                    <Box>
                        <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>实体线</Text>
                        <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 2 }}>人名 / 机构 / 日期 / 金额 / 编号 / 联系方式 / 产品设备</Text>
                    </Box>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>「识别 XX 里的实体」</Text>
                </Box>
                <Box style={{ background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '10px 16px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                    <Box>
                        <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>字段线</Text>
                        <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 2 }}>用户点名的字段，逐个查、逐个核</Text>
                    </Box>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>「提取合同里的甲方与金额」</Text>
                </Box>
            </Box>

            <Box style={{ width: 34, justifyContent: 'center', alignItems: 'center' }}>
                <svg width={34} height={18} viewBox='0 0 34 18'><line x1='0' y1='9' x2='24' y2='9' stroke='#8B97A8' strokeWidth='2' /><path d='M24 3 L33 9 L24 15 Z' fill='#8B97A8' /></svg>
            </Box>

            {/* 库 */}
            <Box style={{ width: 210, background: '#E8EFF8', border: '1px solid #3D7BD9', padding: '18px 18px', justifyContent: 'center' }}>
                <Text style={{ fontSize: 13, color: '#3D7BD9' }}>输出</Text>
                <Text style={{ fontSize: 20, color: '#0E3F8C', fontWeight: 'bold', marginTop: 6 }}>MySQL 五张表</Text>
                <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 6 }}>文档 / 实体 / 画像 / 明细 / 字段</Text>
            </Box>
        </Box>
    </Box>

    {/* 下半：机制 */}
    <Box style={{ position: 'absolute', top: 330, left: 40, width: 1200, flexDirection: 'row', gap: 16 }}>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderTop: '3px solid #1E4FA8', padding: '18px 20px', minHeight: 268, flexShrink: 0 }}>
            <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold' }}>保真：每条都带回原文</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.75, marginTop: 8 }}>
                模型输出"值 + 原文摘抄"，程序拿摘抄回原文定位，记录行号 / 段号 / 格子坐标。定位失败的数据不写库——宁可少一条，不可错一条。
            </Text>
            <Box style={{ marginTop: 12, background: '#F0F5FC', padding: '8px 10px' }}>
                <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>缺出处 0 条 · 定位失败不写库</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderTop: '3px solid #1E4FA8', padding: '18px 20px', minHeight: 268, flexShrink: 0 }}>
            <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold' }}>复核：正则二次校验</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.75, marginTop: 8 }}>
                日期、金额、编号抽出后再用正则验格式；实体还会做"漏报补扫"——把全文按模式再扫一遍，防止模型看漏。
            </Text>
            <Box style={{ marginTop: 12, background: '#F0F5FC', padding: '8px 10px' }}>
                <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>日期 / 金额 / 编号 三类正则</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderTop: '3px solid #1E4FA8', padding: '18px 20px', minHeight: 268, flexShrink: 0 }}>
            <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold' }}>落库：同步式对齐</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.75, marginTop: 8 }}>
                按 run_id 批次号做新增 / 更新 / 移除三步对齐，重复跑不会膨胀；网页、API、命令行三处可查同一份数据。
            </Text>
            <Box style={{ marginTop: 12, background: '#F0F5FC', padding: '8px 10px' }}>
                <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>run_id 可追溯 · 重复跑不膨胀</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 54, width: 1200, background: '#F0F5FC', borderLeft: '4px solid #1E4FA8', padding: '12px 20px' }}>
        <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 'bold' }}>
            判断：提取的价值不在"抽出来"，在"进得去、查得到、追得回"。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 20, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>12 / 22</Text>
    </Box>
</Slide>
