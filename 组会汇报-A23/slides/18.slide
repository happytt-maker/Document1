<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 32, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>验收体系：四份成绩单，合计 73 项，全部可复跑</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>检查脚本不调用模型 —— 结果确定、重跑一致，换人换机器也能得到同一个结论</Text>
    </Box>

    {/* 四张成绩单 */}
    <Box style={{ position: 'absolute', top: 112, left: 40, width: 830 }}>
        <Box style={{ flexDirection: 'row', gap: 14 }}>
            <Box style={{ flex: 1, height: 226, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '18px 20px' }}>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>对照件 01</Text>
                <Text style={{ fontSize: 44, color: '#1E4FA8', fontWeight: 'bold', marginTop: 2 }}>17 / 17</Text>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>作品要求对照</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                    赛题 §5 用户期望 3 条 + §6 技术要求 4 条，逐条翻译成硬检查
                </Text>
            </Box>
            <Box style={{ flex: 1, height: 226, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '18px 20px' }}>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>对照件 02</Text>
                <Text style={{ fontSize: 44, color: '#1E4FA8', fontWeight: 'bold', marginTop: 2 }}>22 / 22</Text>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>模块二收口总检</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                    模块原文 8 项 + 技术指标 5 项 + 工程件 5 项 + 数据一致性 4 项
                </Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 14 }}>
            <Box style={{ flex: 1, height: 226, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '18px 20px' }}>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>对照件 03</Text>
                <Text style={{ fontSize: 44, color: '#1E4FA8', fontWeight: 'bold', marginTop: 2 }}>26 / 26</Text>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>模块三收口总检</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                    赛题原文逐句对齐：脚本 / 模板 / 检索 / 填写 / 格式
                </Text>
            </Box>
            <Box style={{ flex: 1, height: 226, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '18px 20px' }}>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>对照件 04</Text>
                <Text style={{ fontSize: 44, color: '#1E4FA8', fontWeight: 'bold', marginTop: 2 }}>8 / 8</Text>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>模块一覆盖矩阵</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                    四类操作 × 四种格式的关键组合，逐一真跑（含模型解析）
                </Text>
            </Box>
        </Box>
    </Box>

    {/* 右：合计 */}
    <Box style={{ position: 'absolute', top: 112, left: 894, width: 346, height: 466, background: '#0E3F8C', padding: '26px 28px', justifyContent: 'space-between' }}>
        <Box>
            <Text style={{ fontSize: 14, color: '#A9C2E8', letterSpacing: 1 }}>TOTAL</Text>
            <Text style={{ fontSize: 84, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.1, marginTop: 4 }}>73</Text>
            <Text style={{ fontSize: 20, color: '#FFFFFF', fontWeight: 'bold', marginTop: 2 }}>项检查</Text>
            <Box style={{ width: 48, height: 3, background: '#FFC107', marginTop: 16 }} />
            <Text style={{ fontSize: 16, color: '#D5E2F5', lineHeight: 1.8, marginTop: 16 }}>
                2026-10-15 现场复核<br />四份总检 + 服务健康<br />全部一次通过
            </Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#A9C2E8', lineHeight: 1.6 }}>
            验收件本身也是资产：<br />随时可重跑，不必相信口头结论。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 16, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>18 / 22</Text>
    </Box>
</Slide>
