<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 34, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>模块三：给一张陌生模板，填出能交卷的表</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>Excel / Word 双形态 · 模板结构现场才给 · 输出必须与模板格式逐格一致</Text>
    </Box>

    {/* 上：五段流程 */}
    <Box style={{ position: 'absolute', top: 116, left: 40, width: 1200, flexDirection: 'row', alignItems: 'center', gap: 9 }}>
        <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '14px 16px', height: 104 }}>
            <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>STEP 1</Text>
            <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>读懂模板</Text>
            <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 4, lineHeight: 1.5 }}>找表头行、列名、待填区</Text>
        </Box>
        <svg width={22} height={16} viewBox='0 0 22 16'><path d='M0 8 L14 8 M13 3 L21 8 L13 13 Z' stroke='#8B97A8' strokeWidth='1.6' fill='none' /></svg>
        <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '14px 16px', height: 104 }}>
            <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>STEP 2</Text>
            <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>检索证据</Text>
            <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 4, lineHeight: 1.5 }}>按列名从文档池筛候选块</Text>
        </Box>
        <svg width={22} height={16} viewBox='0 0 22 16'><path d='M0 8 L14 8 M13 3 L21 8 L13 13 Z' stroke='#8B97A8' strokeWidth='1.6' fill='none' /></svg>
        <Box style={{ flex: 1, background: '#1E4FA8', padding: '14px 16px', height: 104 }}>
            <Text style={{ fontSize: 13, color: '#BFD3EE', fontWeight: 'bold' }}>STEP 3</Text>
            <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold', marginTop: 4 }}>模型判值</Text>
            <Text style={{ fontSize: 13, color: '#DCE7F7', marginTop: 4, lineHeight: 1.5 }}>只输出值 + 原文摘抄</Text>
        </Box>
        <svg width={22} height={16} viewBox='0 0 22 16'><path d='M0 8 L14 8 M13 3 L21 8 L13 13 Z' stroke='#8B97A8' strokeWidth='1.6' fill='none' /></svg>
        <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '14px 16px', height: 104 }}>
            <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>STEP 4</Text>
            <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>程序写回</Text>
            <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 4, lineHeight: 1.5 }}>只改值，不碰样式与公式</Text>
        </Box>
        <svg width={22} height={16} viewBox='0 0 22 16'><path d='M0 8 L14 8 M13 3 L21 8 L13 13 Z' stroke='#8B97A8' strokeWidth='1.6' fill='none' /></svg>
        <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '14px 16px', height: 104 }}>
            <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>STEP 5</Text>
            <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>双检定</Text>
            <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 4, lineHeight: 1.5 }}>值比对 + 全表格式比对</Text>
        </Box>
    </Box>

    {/* 下：三铁律 + 实测 */}
    <Box style={{ position: 'absolute', top: 248, left: 40, width: 720 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', letterSpacing: 1 }}>写回的三条铁律</Text>
        <Box style={{ marginTop: 10, gap: 10 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', border: '1px solid #E5E7EB', borderLeft: '3px solid #1E4FA8', padding: '22px 18px' }}>
                <Text style={{ fontSize: 20, color: '#1E4FA8', fontWeight: 'bold', width: 30 }}>1</Text>
                <Text style={{ fontSize: 17, color: '#1A2230' }}>永不改原模板 —— 输出永远是新副本</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', border: '1px solid #E5E7EB', borderLeft: '3px solid #1E4FA8', padding: '22px 18px' }}>
                <Text style={{ fontSize: 20, color: '#1E4FA8', fontWeight: 'bold', width: 30 }}>2</Text>
                <Text style={{ fontSize: 17, color: '#1A2230' }}>先查后写 —— 待填区已有内容就停下，交人拍板</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', border: '1px solid #E5E7EB', borderLeft: '3px solid #1E4FA8', padding: '22px 18px' }}>
                <Text style={{ fontSize: 20, color: '#1E4FA8', fontWeight: 'bold', width: 30 }}>3</Text>
                <Text style={{ fontSize: 17, color: '#1A2230' }}>只填值不碰格式 —— 字体、边框、合并、公式一律不动</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', top: 248, left: 792, width: 448 }}>
        <Box style={{ background: '#F0F5FC', border: '1px solid #C9D8EC', padding: '18px 22px' }}>
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>实测（5 张 Excel 模板）</Text>
            <Text style={{ fontSize: 40, color: '#1E4FA8', fontWeight: 'bold', marginTop: 2 }}>10.2 ~ 19.4 s</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 4 }}>单张完整跑完：读文档 → 填 → 自检</Text>
            <Box style={{ height: 1, background: '#C9D8EC', marginTop: 12 }} />
            <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 10, lineHeight: 1.6 }}>
                10 份验收报告：格式差异 <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>0 处</span><br />
                值一致 <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>100%</span> ｜ Word 模板连测 5/5
            </Text>
        </Box>
        <Box style={{ marginTop: 14 }}>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7 }}>
                判断：填表题的胜负不在"能不能填"，而在"交上去还需不需要人再改一遍"。
            </Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 54, width: 1200, background: '#F0F5FC', borderLeft: '4px solid #1E4FA8', padding: '12px 20px' }}>
        <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 'bold' }}>
            Word 模板更难：合并单元格 + 段落结构，同样只写值不碰格式 —— Word 连测 5/5 全过。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 20, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>14 / 22</Text>
    </Box>
</Slide>
