<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 34, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>进度盘点：系统已闭环，剩下的是"把材料写出来"</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>这一页想讲清楚一个判断：后续不需要再开发新功能</Text>
    </Box>

    {/* 左：已完成 */}
    <Box style={{ position: 'absolute', top: 120, left: 40, width: 620 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <FAIcon name='check-circle' fill='#1E7A4B' style={{ width: 24, height: 24 }} />
            <Text style={{ fontSize: 22, color: '#1A2230', fontWeight: 'bold' }}>已完成</Text>
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>可运行、可复跑</Text>
        </Box>
        <Box style={{ marginTop: 14, gap: 10 }}>
            <Box style={{ background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '17px 18px' }}>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>三个必须模块全部落地</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 3 }}>文档操作 / 信息提取入库 / 表格填写，共 20 项功能</Text>
            </Box>
            <Box style={{ background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '17px 18px' }}>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>赛题 7 条要求 17/17 对照通过</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 3 }}>含识别专属异步 API 与填表 API</Text>
            </Box>
            <Box style={{ background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '17px 18px' }}>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>73 项现场复核全过</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 3 }}>2026-10-15 复跑，四份总检 + 服务健康</Text>
            </Box>
            <Box style={{ background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '17px 18px' }}>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>可运行 Demo 已具备</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 3 }}>双击启动操作台 ｜ 一键全链路演示 ｜ 命令行入口</Text>
            </Box>
            <Box style={{ background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '17px 18px' }}>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>4 份总检 + 13 份验收脚本</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 3 }}>零模型或可重跑，不依赖人工记忆</Text>
            </Box>
        </Box>
    </Box>

    {/* 分隔线 */}
    <Box style={{ position: 'absolute', top: 130, left: 690, width: 1, height: 480, background: '#D6DCE5' }} />

    {/* 右：待完成 */}
    <Box style={{ position: 'absolute', top: 120, left: 728, width: 512 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <FAIcon name='clock' fill='#B8860B' style={{ width: 24, height: 24 }} />
            <Text style={{ fontSize: 22, color: '#1A2230', fontWeight: 'bold' }}>待完成</Text>
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>全部是"汇编成稿"</Text>
        </Box>
        <Box style={{ marginTop: 14, gap: 8 }}>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', background: '#FFF8E1', padding: '11px 16px' }}>
                <Text style={{ fontSize: 16, color: '#1A2230' }}>项目详细方案</Text>
                <Text style={{ fontSize: 13, color: '#8A6D1F' }}>素材最全</Text>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', background: '#FFF8E1', padding: '11px 16px' }}>
                <Text style={{ fontSize: 16, color: '#1A2230' }}>项目概要介绍</Text>
                <Text style={{ fontSize: 13, color: '#8A6D1F' }}>可由方案截取</Text>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', background: '#FFF8E1', padding: '11px 16px' }}>
                <Text style={{ fontSize: 16, color: '#1A2230' }}>关键模块说明（≤3 创新点）</Text>
                <Text style={{ fontSize: 13, color: '#8A6D1F' }}>创新点已定</Text>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', background: '#FFF8E1', padding: '11px 16px' }}>
                <Text style={{ fontSize: 16, color: '#1A2230' }}>项目简介 PPT</Text>
                <Text style={{ fontSize: 13, color: '#8A6D1F' }}>即本次汇报</Text>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', background: '#FFF8E1', padding: '11px 16px' }}>
                <Text style={{ fontSize: 16, color: '#1A2230' }}>项目演示视频</Text>
                <Text style={{ fontSize: 13, color: '#8A6D1F' }}>链路现成，最后录</Text>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '11px 16px' }}>
                <Text style={{ fontSize: 16, color: '#1A2230' }}>素材来源说明（一页）</Text>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>未用训练素材，易写</Text>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '11px 16px' }}>
                <Text style={{ fontSize: 16, color: '#1A2230' }}>团队补充材料（可选）</Text>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>13 份报告可选送</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 20, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>20 / 22</Text>
    </Box>
</Slide>
