<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 32, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>赛题考什么：三个模块 + 四项指标</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>模块缺一不可，指标里有两项能一票否决 —— 这就是我们的需求清单</Text>
    </Box>

    {/* 三个必须模块 */}
    <Box style={{ position: 'absolute', top: 108, left: 40, width: 1200 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 4, height: 20, background: '#1E4FA8' }} />
            <Text style={{ fontSize: 18, color: '#0E3F8C', fontWeight: 'bold' }}>三个必须模块</Text>
            <Text style={{ fontSize: 13, color: '#8B97A8' }}>赛题原文："本程序必须包含以下三个关键模块"</Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 10 }}>
            <Box style={{ flex: 1, height: 196, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '16px 18px' }}>
                <Text style={{ fontSize: 12, color: '#1E4FA8', fontWeight: 'bold', letterSpacing: 1 }}>MODULE 01</Text>
                <Text style={{ fontSize: 21, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>文档智能操作</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7, marginTop: 8 }}>
                    自然语言指令 → 解析 → 自动执行。覆盖编辑、排版、格式调整、内容提取，且要"理解文档结构"，不能只是字符串替换。
                </Text>
                <Text style={{ fontSize: 13, color: '#8B97A8', marginTop: 8 }}>意图解析 · 结构感知</Text>
            </Box>
            <Box style={{ flex: 1, height: 196, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '16px 18px' }}>
                <Text style={{ fontSize: 12, color: '#1E4FA8', fontWeight: 'bold', letterSpacing: 1 }}>MODULE 02</Text>
                <Text style={{ fontSize: 21, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>非结构化信息提取</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7, marginTop: 8 }}>
                    自动识别导入文档，提取关键信息、实体数据或用户指定内容，并完成数据库存储。原文还加了一句硬要求："不存在数据识别误差"。
                </Text>
                <Text style={{ fontSize: 13, color: '#8B97A8', marginTop: 8 }}>提取 · 入库 · 保真</Text>
            </Box>
            <Box style={{ flex: 1, height: 196, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '16px 18px' }}>
                <Text style={{ fontSize: 12, color: '#1E4FA8', fontWeight: 'bold', letterSpacing: 1 }}>MODULE 03</Text>
                <Text style={{ fontSize: 21, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>表格自定义填写</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7, marginTop: 8 }}>
                    用户给表格 + 非结构化数据，从数据里自动搜索相关信息并填进表格。用户期望里还追加一条：生成"格式严谨"的汇总表。
                </Text>
                <Text style={{ fontSize: 13, color: '#8B97A8', marginTop: 8 }}>检索 · 判值 · 写回</Text>
            </Box>
        </Box>
    </Box>

    {/* 四项指标 */}
    <Box style={{ position: 'absolute', top: 344, left: 40, width: 1200 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 4, height: 20, background: '#1E4FA8' }} />
            <Text style={{ fontSize: 18, color: '#0E3F8C', fontWeight: 'bold' }}>四项技术指标</Text>
            <Text style={{ fontSize: 13, color: '#8B97A8' }}>准确率与响应时间是唯一的硬门槛</Text>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 12, marginTop: 10 }}>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderTop: '3px solid #3D7BD9', padding: '12px 14px', height: 172 }}>
                <Text style={{ fontSize: 12, color: '#8B97A8', fontWeight: 'bold' }}>指标 01</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold', marginTop: 2 }}>程序形态不限</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                    H5 / App / Web / PC 均可；可基于第三方商业 AI 平台
                </Text>
                <Box style={{ marginTop: 8, background: '#F7F9FC', padding: '6px 8px' }}>
                    <Text style={{ fontSize: 13, color: '#0E3F8C' }}>我们：Web 操作台 + CLI</Text>
                </Box>
            </Box>
            <Box style={{ flex: 1, background: '#FFF8E1', border: '1px solid #F0DCA8', borderTop: '3px solid #FFC107', padding: '12px 14px', height: 172 }}>
                <Text style={{ fontSize: 12, color: '#8A6D1F', fontWeight: 'bold' }}>指标 02 · 硬门槛</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold', marginTop: 2 }}>准确率 &gt; 80%</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                    多类型数据稳定运行，信息提取不得有过大误差
                </Text>
                <Box style={{ marginTop: 8, background: '#FFFDF5', padding: '6px 8px' }}>
                    <Text style={{ fontSize: 13, color: '#8A6D1F', fontWeight: 'bold' }}>实测：最高 96.8%，最低 85.7%</Text>
                </Box>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderTop: '3px solid #3D7BD9', padding: '12px 14px', height: 172 }}>
                <Text style={{ fontSize: 12, color: '#8B97A8', fontWeight: 'bold' }}>指标 03</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold', marginTop: 2 }}>样本人工标注</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                    训练与验证样本均需人工标注，并经过多轮审核
                </Text>
                <Box style={{ marginTop: 8, background: '#F7F9FC', padding: '6px 8px' }}>
                    <Text style={{ fontSize: 13, color: '#0E3F8C' }}>6 轮审核 + 标准答案档案</Text>
                </Box>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderTop: '3px solid #3D7BD9', padding: '12px 14px', height: 172 }}>
                <Text style={{ fontSize: 12, color: '#8B97A8', fontWeight: 'bold' }}>指标 04</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold', marginTop: 2 }}>识别 API 异步</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                    识别分类模块必须提供接口，且支持异步调用
                </Text>
                <Box style={{ marginTop: 8, background: '#F7F9FC', padding: '6px 8px' }}>
                    <Text style={{ fontSize: 13, color: '#0E3F8C' }}>/api/recognize + job 轮询</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 44, width: 1200, background: '#F0F5FC', borderLeft: '4px solid #1E4FA8', padding: '12px 20px' }}>
        <Text style={{ fontSize: 17, color: '#0E3F8C', fontWeight: 'bold' }}>
            判断：这七条就是需求清单 —— 我们的做法是把每一条都翻译成一个可执行的检查项。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 16, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>06 / 22</Text>
    </Box>
</Slide>
