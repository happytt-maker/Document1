<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    {/* 左栏深蓝 */}
    <Box style={{ position: 'absolute', top: 8, left: 0, width: 380, height: 652, background: '#0E3F8C', padding: '0 44px', justifyContent: 'center' }}>
        <Text style={{ fontSize: 14, color: '#A9C2E8', letterSpacing: 2 }}>CONTENTS</Text>
        <Text style={{ fontSize: 46, color: '#FFFFFF', fontWeight: 'bold', marginTop: 12 }}>汇报目录</Text>
        <Box style={{ width: 56, height: 4, background: '#FFC107', marginTop: 24 }} />
        <Text style={{ fontSize: 17, color: '#D5E2F5', lineHeight: 1.8, marginTop: 24 }}>
            先把比赛怎么判讲清楚，<br />再讲我们怎么答卷，<br />最后交代做到哪一步。
        </Text>
    </Box>

    {/* 右侧条目 */}
    <Box style={{ position: 'absolute', top: 92, left: 440, width: 780 }}>
        <Box style={{ flexDirection: 'row', gap: 24, paddingBottom: 26, borderBottom: '1px solid #D6DCE5' }}>
            <Text style={{ fontSize: 40, color: '#1E4FA8', fontWeight: 'bold', width: 70 }}>01</Text>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 27, color: '#1A2230', fontWeight: 'bold' }}>赛题解析：它到底考什么</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', marginTop: 8, lineHeight: 1.6 }}>
                    三个必须模块、四项技术指标，以及比赛当天的真实评测流程
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#8B97A8', paddingTop: 12 }}>P03–P07</Text>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 24, paddingTop: 24, paddingBottom: 26, borderBottom: '1px solid #D6DCE5' }}>
            <Text style={{ fontSize: 40, color: '#1E4FA8', fontWeight: 'bold', width: 70 }}>02</Text>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 27, color: '#1A2230', fontWeight: 'bold' }}>系统方案：我们怎么答卷</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', marginTop: 8, lineHeight: 1.6 }}>
                    一条五层管线，三个模块分别解决"读、存、填"三件事
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#8B97A8', paddingTop: 12 }}>P08–P15</Text>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 24, paddingTop: 24 }}>
            <Text style={{ fontSize: 40, color: '#1E4FA8', fontWeight: 'bold', width: 70 }}>03</Text>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 27, color: '#1A2230', fontWeight: 'bold' }}>验证与计划：做到哪一步</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', marginTop: 8, lineHeight: 1.6 }}>
                    按比赛口径实测的硬指标、73 项复核，以及剩余待办
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#8B97A8', paddingTop: 12 }}>P16–P21</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 440, bottom: 70, width: 780, background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '12px 18px' }}>
        <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.6 }}>
            本汇报所有数字来自 2026-10-15 现场复核（四份总检 73 项全过），不是估算值。
        </Text>
    </Box>

    {/* 页脚 */}
    <Box style={{ position: 'absolute', left: 40, bottom: 20, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>02 / 22</Text>
    </Box>
</Slide>
