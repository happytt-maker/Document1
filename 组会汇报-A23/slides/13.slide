<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 34, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>数据底座：266 条，全部能回到原文</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>这个 100% 不是模型自评，是零模型反向审计 —— 把库里的每条数据拉回原文核对</Text>
    </Box>

    {/* 左：大数字 */}
    <Box style={{ position: 'absolute', top: 122, left: 40, width: 520, height: 500, background: '#F0F5FC', border: '1px solid #D6DCE5', padding: '28px 32px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', letterSpacing: 1 }}>当前库内总量</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 12, marginTop: 4 }}>
            <Text style={{ fontSize: 120, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>266</Text>
            <Text style={{ fontSize: 22, color: '#1A2230', fontWeight: 'bold', paddingBottom: 16 }}>条</Text>
        </Box>
        <Box style={{ height: 1, background: '#D6DCE5', marginTop: 18 }} />
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 12, marginTop: 18 }}>
            <Text style={{ fontSize: 84, color: '#0E3F8C', fontWeight: 'bold', lineHeight: 1 }}>100%</Text>
            <Text style={{ fontSize: 18, color: '#1A2230', paddingBottom: 10 }}>可回溯原文</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7, marginTop: 16 }}>
            缺摘抄 0 条 · 缺出处 0 条 · 定位失败不写库
        </Text>
    </Box>

    {/* 右：拆解 */}
    <Box style={{ position: 'absolute', top: 122, left: 594, width: 646 }}>
        <Box style={{ flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: '14px 16px' }}>
                <Text style={{ fontSize: 32, color: '#1E4FA8', fontWeight: 'bold' }}>9</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 2 }}>份文档</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: '14px 16px' }}>
                <Text style={{ fontSize: 32, color: '#1E4FA8', fontWeight: 'bold' }}>137</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 2 }}>条实体</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: '14px 16px' }}>
                <Text style={{ fontSize: 32, color: '#1E4FA8', fontWeight: 'bold' }}>4</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 2 }}>份画像</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: '14px 16px' }}>
                <Text style={{ fontSize: 32, color: '#1E4FA8', fontWeight: 'bold' }}>75</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', marginTop: 2 }}>个字段值</Text>
            </Box>
        </Box>

        <Box style={{ marginTop: 18, background: '#FFFFFF', border: '1px solid #E5E7EB', padding: '18px 22px' }}>
            <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold' }}>审计怎么做的</Text>
            <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.8, marginTop: 8 }}>
                反向审计：从数据库读出每一条记录，按记录里的出处坐标回到源文件的对应位置，比对原文摘抄与实际文本是否一致。全程不调用模型，重跑结果必然相同。
            </Text>
        </Box>

        <Box style={{ marginTop: 14, flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '14px 16px' }}>
                <Text style={{ fontSize: 14, color: '#8B97A8' }}>三线查全率（对照人工标准答案）</Text>
                <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold', marginTop: 6 }}>实体 100% · 画像 90% · 字段 100%</Text>
            </Box>
        </Box>

        <Box style={{ marginTop: 14, background: '#FFFFFF', border: '1px solid #E5E7EB', padding: '14px 18px' }}>
            <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold' }}>为什么不用模型自评</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7, marginTop: 6 }}>
                让模型检查自己，等于让它给自己打分，错的地方往往正是它看不到的地方。换成正则 + 原文比对，才能发现"编造"和"真假拼接"。
            </Text>
        </Box>

        <Box style={{ marginTop: 14, background: '#F0F5FC', borderLeft: '4px solid #1E4FA8', padding: '12px 18px' }}>
            <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 'bold' }}>
                判断：库里的数据"敢给人看"，才谈得上后面拿它去填表。
            </Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 20, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>13 / 22</Text>
    </Box>
</Slide>
