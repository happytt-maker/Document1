<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    {/* 顶部深蓝条 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    {/* 右侧浅蓝底块 */}
    <Box style={{ position: 'absolute', top: 8, right: 0, width: 396, height: 612, background: '#F0F5FC' }} />

    {/* 右侧管线抽象 SVG */}
    <svg width={396} height={612} viewBox='0 0 396 612' style={{ position: 'absolute', top: 8, right: 0 }}>
        <rect x='96' y='96' width='204' height='52' rx='6' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1.5' />
        <rect x='96' y='184' width='204' height='52' rx='6' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1.5' />
        <rect x='96' y='272' width='204' height='52' rx='6' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1.5' />
        <rect x='96' y='360' width='204' height='52' rx='6' fill='#1E4FA8' />
        <rect x='96' y='448' width='204' height='52' rx='6' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1.5' />
        <line x1='198' y1='148' x2='198' y2='184' stroke='#8B97A8' strokeWidth='2' />
        <line x1='198' y1='236' x2='198' y2='272' stroke='#8B97A8' strokeWidth='2' />
        <line x1='198' y1='324' x2='198' y2='360' stroke='#8B97A8' strokeWidth='2' />
        <line x1='198' y1='412' x2='198' y2='448' stroke='#8B97A8' strokeWidth='2' />
        <circle cx='198' cy='392' r='5' fill='#FFC107' />
    </svg>
    <Box style={{ position: 'absolute', top: 44, right: 0, width: 396, height: 30, justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#4A5568', letterSpacing: 1 }}>读 取 ｜ 定 位 ｜ 理 解 ｜ 匹 配 ｜ 写 回</Text>
    </Box>

    {/* 左上标识 */}
    <Box style={{ position: 'absolute', top: 52, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 4, justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>A</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568', letterSpacing: 1 }}>A-23 赛题 · 阶段汇报</Text>
    </Box>

    {/* 主标题区 */}
    <Box style={{ position: 'absolute', top: 150, left: 60, width: 800 }}>
        <Text style={{ fontSize: 15, color: '#3D7BD9', fontWeight: 'bold', letterSpacing: 0.5 }}>
            第 17 届中国大学生服务外包创新创业大赛 · A 类赛题
        </Text>
        <Text style={{ fontSize: 60, color: '#0E3F8C', fontWeight: 'bold', lineHeight: 1.22, marginTop: 22 }}>
            基于大语言模型的<br />文档理解与多源数据融合系统
        </Text>
        <Text style={{ fontSize: 17, color: '#8B97A8', marginTop: 14, letterSpacing: 0.3 }}>
            Document Understanding &amp; Multi-source Data Fusion System
        </Text>
        <Box style={{ width: 72, height: 4, background: '#FFC107', marginTop: 30 }} />
        <Text style={{ fontSize: 24, color: '#1A2230', marginTop: 22, lineHeight: 1.5 }}>
            从一堆格式不一的文档，到一张可直接交卷的表
        </Text>
    </Box>

    {/* 底部信息条 */}
    <Box style={{ position: 'absolute', left: 0, bottom: 0, width: 1280, height: 100, background: '#F7F9FC', borderTop: '1px solid #D6DCE5', flexDirection: 'row', alignItems: 'center', paddingLeft: 60, paddingRight: 60, justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', gap: 56 }}>
            <Box>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>出题单位</Text>
                <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>金陵科技学院</Text>
            </Box>
            <Box>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>汇报人</Text>
                <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>覃敬涛</Text>
            </Box>
            <Box>
                <Text style={{ fontSize: 13, color: '#8B97A8' }}>汇报时间</Text>
                <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold', marginTop: 4 }}>2026 年 10 月 22 日</Text>
            </Box>
        </Box>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>课题组组会</Text>
    </Box>
</Slide>
