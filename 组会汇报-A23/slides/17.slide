<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 32, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>硬指标实测：四项全部达标，最差仍有 2 倍余量</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>口径照赛题【评价方法】：16 份规格样本 + 5 张模板，逐张计时、逐格对分</Text>
    </Box>

    {/* 左：表格 */}
    <Box style={{ position: 'absolute', top: 112, left: 40, width: 700 }}>
        <Table
            style={{ width: '100%', height: 470 }}
            defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#1A2230' }}
            defaultCellStyle={{
                border: {
                    left: { width: 0, color: '#FFFFFF' },
                    right: { width: 0, color: '#FFFFFF' },
                    top: { width: 0, color: '#FFFFFF' },
                    bottom: { width: 1, color: '#D6DCE5' },
                },
            }}
            cells={[
                [
                    { text: '考核项', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '赛题阈值', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '我们的实测', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#0E3F8C' } } },
                ],
                [
                    { text: '样本规格', textStyle: { bold: true } },
                    '16 份（5+5+3+3）',
                    { text: '16/16 全部达标', textStyle: { color: '#0E3F8C', bold: true } },
                ],
                [
                    { text: '单表准确率', textStyle: { bold: true }, cellStyle: { background: { color: '#F7F9FC' } } },
                    { text: '≥ 80%', textStyle: { color: '#B04A45', bold: true }, cellStyle: { background: { color: '#F7F9FC' } } },
                    { text: '严格 85.7% ｜ 宽松 100%', cellStyle: { background: { color: '#F7F9FC' } } },
                ],
                [
                    { text: '单表响应', textStyle: { bold: true } },
                    { text: '≤ 90 秒', textStyle: { color: '#B04A45', bold: true } },
                    '10.19 ~ 43.68 秒',
                ],
                [
                    { text: '平均响应', textStyle: { bold: true }, cellStyle: { background: { color: '#F7F9FC' } } },
                    '5 张取平均',
                    { text: '30.34 s / 16.30 s', cellStyle: { background: { color: '#F7F9FC' } } },
                ],
                [
                    { text: '模板形态', textStyle: { bold: true } },
                    'word 或 excel',
                    { text: 'Excel 5/5 ｜ Word 5/5', textStyle: { color: '#0E3F8C', bold: true } },
                ],
            ]}
        />
        <Box style={{ flexDirection: 'row', gap: 10, marginTop: 10 }}>
            <FAIcon name='check-circle' fill='#1E7A4B' style={{ width: 20, height: 20 }} />
            <Text style={{ fontSize: 15, color: '#1E7A4B', fontWeight: 'bold' }}>五项全部达标（准确率、响应时间、样本、模板、形态）</Text>
        </Box>
    </Box>

    {/* 右：图表 */}
    <Box style={{ position: 'absolute', top: 112, left: 784, width: 456 }}>
        <Text style={{ fontSize: 15, color: '#4A5568', fontWeight: 'bold' }}>5 张模板的单表响应（大文档池）</Text>
        <Chart
            style={{ width: 456, height: 330, marginTop: 6 }}
            chartType='barChart'
            barDirection='bar'
            showLegend={false}
            showDataLabels={true}
            dataLabelColor='#1A2230'
            axisColor='#8B97A8'
            colors={['#1E4FA8']}
            background='#FFFFFF'
            data={[
                ['模板', '秒'],
                ['模板1', 29.14],
                ['模板2', 26.99],
                ['模板3', 18.47],
                ['模板4', 33.44],
                ['模板5', 43.68],
            ]}
        />
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 24, height: 3, background: '#D9534F' }} />
            <Text style={{ fontSize: 13, color: '#B04A45' }}>赛题红线：单表 ≤ 90 秒（图中最慢 43.68 秒）</Text>
        </Box>

        <Box style={{ marginTop: 12, background: '#F0F5FC', border: '1px solid #C9D8EC', padding: '14px 16px' }}>
            <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 'bold' }}>判断</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7, marginTop: 4 }}>
                最慢一张距红线还有约一倍空间；准确率按最严口径也高于 80%。
            </Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 16, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>17 / 22</Text>
    </Box>
</Slide>
