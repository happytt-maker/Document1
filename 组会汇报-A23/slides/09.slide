<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 32, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>总体架构：五层管线，每一层都能单独验收</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>输入是 16 份格式不一的文档，输出是一张格式不变、值已填好的表</Text>
    </Box>

    {/* 左：架构图 */}
    <Box style={{ position: 'absolute', top: 112, left: 40, width: 760 }}>
        <Box style={{ height: 52, background: '#F0F5FC', border: '1px solid #C9D8EC', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 18, paddingRight: 18 }}>
            <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>非结构化文档</Text>
            <Text style={{ fontSize: 14, color: '#4A5568' }}>docx ｜ xlsx ｜ md ｜ txt</Text>
        </Box>
        <Box style={{ alignItems: 'center', height: 24, justifyContent: 'center' }}>
            <svg width={18} height={24} viewBox='0 0 18 24'><line x1='9' y1='0' x2='9' y2='15' stroke='#8B97A8' strokeWidth='2' /><path d='M3 14 L9 23 L15 14 Z' fill='#8B97A8' /></svg>
        </Box>

        <Box style={{ position: 'relative', height: 196 }}>
            <Box style={{ position: 'absolute', left: 0, top: 0, width: 144, height: 196, background: '#F7F9FC', padding: '16px 12px' }}>
                <Text style={{ fontSize: 12, color: '#8B97A8', fontWeight: 'bold' }}>LAYER 1</Text>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 6 }}>四格式读取</Text>
                <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.6, marginTop: 8 }}>统一解析文本与表格结构</Text>
            </Box>
            <Box style={{ position: 'absolute', left: 154, top: 0, width: 144, height: 196, background: '#F7F9FC', padding: '16px 12px' }}>
                <Text style={{ fontSize: 12, color: '#8B97A8', fontWeight: 'bold' }}>LAYER 2</Text>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 6 }}>分块定位</Text>
                <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.6, marginTop: 8 }}>每块带行号 / 段号 / 格子坐标</Text>
            </Box>
            <Box style={{ position: 'absolute', left: 308, top: 0, width: 144, height: 196, background: '#F7F9FC', padding: '16px 12px' }}>
                <Text style={{ fontSize: 12, color: '#8B97A8', fontWeight: 'bold' }}>LAYER 3</Text>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 6 }}>模板理解</Text>
                <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.6, marginTop: 8 }}>自动找表头行与待填区</Text>
            </Box>
            <Box style={{ position: 'absolute', left: 462, top: 0, width: 144, height: 196, background: '#1E4FA8', padding: '14px 12px' }}>
                <Text style={{ fontSize: 12, color: '#BFD3EE', fontWeight: 'bold' }}>LAYER 4</Text>
                <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold', marginTop: 6 }}>证据匹配</Text>
                <Text style={{ fontSize: 13, color: '#DCE7F7', lineHeight: 1.6, marginTop: 8 }}>检索 → 模型判值 → 程序定位</Text>
            </Box>
            <Box style={{ position: 'absolute', left: 616, top: 0, width: 144, height: 196, background: '#F7F9FC', padding: '16px 12px' }}>
                <Text style={{ fontSize: 12, color: '#8B97A8', fontWeight: 'bold' }}>LAYER 5</Text>
                <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold', marginTop: 6 }}>保格式写回</Text>
                <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.6, marginTop: 8 }}>只填值，不碰任何样式</Text>
            </Box>
        </Box>

        <Box style={{ alignItems: 'center', height: 24, justifyContent: 'center' }}>
            <svg width={18} height={24} viewBox='0 0 18 24'><line x1='9' y1='0' x2='9' y2='15' stroke='#8B97A8' strokeWidth='2' /><path d='M3 14 L9 23 L15 14 Z' fill='#8B97A8' /></svg>
        </Box>

        <Box style={{ height: 54, background: '#E8EFF8', border: '1px solid #3D7BD9', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 18, paddingRight: 18 }}>
            <Text style={{ fontSize: 17, color: '#0E3F8C', fontWeight: 'bold' }}>已填写的汇总表</Text>
            <Text style={{ fontSize: 14, color: '#4A5568' }}>原模板逐字节不变 ｜ 格式差异 0 处</Text>
        </Box>

        <Box style={{ marginTop: 12, background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '12px 18px' }}>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6 }}>
                第 1~3 层是确定性工程，第 4 层才用大模型，第 5 层又回到确定性代码。
            </Text>
        </Box>
    </Box>

    {/* 右：说明 */}
    <Box style={{ position: 'absolute', top: 112, left: 830, width: 410 }}>
        <Box style={{ background: '#0E3F8C', padding: '20px 22px' }}>
            <Text style={{ fontSize: 14, color: '#A9C2E8', letterSpacing: 1 }}>为什么拆五层</Text>
            <Text style={{ fontSize: 17, color: '#FFFFFF', lineHeight: 1.75, marginTop: 8 }}>
                出问题时能定位到层：是读取漏了、定位错了、模板读歪了，还是模型判错。而不是一句"模型不行"。
            </Text>
        </Box>

        <Box style={{ marginTop: 15, gap: 11 }}>
            <Box style={{ borderLeft: '3px solid #3D7BD9', paddingLeft: 12 }}>
                <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold' }}>模型只做判断</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55, marginTop: 3 }}>抽"值 + 原文摘抄"，不数行号、不写表格</Text>
            </Box>
            <Box style={{ borderLeft: '3px solid #3D7BD9', paddingLeft: 12 }}>
                <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold' }}>程序负责定位与验收</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55, marginTop: 3 }}>拿摘抄回原文找位置，找不到就不写</Text>
            </Box>
            <Box style={{ borderLeft: '3px solid #3D7BD9', paddingLeft: 12 }}>
                <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold' }}>每层都有独立验收件</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55, marginTop: 3 }}>总检可复跑，换数据也能重测</Text>
            </Box>
        </Box>

        <Box style={{ marginTop: 16, background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '12px 14px' }}>
            <Text style={{ fontSize: 13, color: '#8B97A8' }}>换一批文档时，需要重写的只有第 2 层的位置适配</Text>
            <Text style={{ fontSize: 14, color: '#1A2230', lineHeight: 1.6, marginTop: 4 }}>
                第 3~5 层与文档内容无关，模板换了也不用改代码。
            </Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 54, width: 1200, background: '#F0F5FC', borderLeft: '4px solid #1E4FA8', padding: '12px 20px' }}>
        <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 'bold' }}>
            换文档、换模板都不用改第 3~5 层 —— 这是系统能接住"比赛现场才给模板"的底气。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 18, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>09 / 22</Text>
    </Box>
</Slide>
