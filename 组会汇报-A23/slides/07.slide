<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />

    <Box style={{ position: 'absolute', top: 36, left: 40, width: 1200 }}>
        <Text style={{ fontSize: 34, color: '#0E3F8C', fontWeight: 'bold' }}>比赛当天怎么测：五个动作、两条红线</Text>
        <Text style={{ fontSize: 16, color: '#8B97A8', marginTop: 6 }}>赛题【评价方法】写得很细，我们把这条流程原样做成了验收脚本</Text>
    </Box>

    {/* 时间轴 */}
    <Box style={{ position: 'absolute', top: 128, left: 40, width: 1200 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 10 }}>
            <Box style={{ flex: 1 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, borderRadius: 17, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>1</Text>
                    </Box>
                    <Box style={{ flex: 1, height: 2, background: '#D6DCE5' }} />
                </Box>
                <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold', marginTop: 12 }}>上传全部样本</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.65, marginTop: 8 }}>
                    16 份一起传：5 份 docx（≥500KB）、5 份 xlsx（≥500KB）、3 份 md（≥15KB）、3 份 txt（≥15KB）
                </Text>
            </Box>
            <Box style={{ flex: 1 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, borderRadius: 17, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>2</Text>
                    </Box>
                    <Box style={{ flex: 1, height: 2, background: '#D6DCE5' }} />
                </Box>
                <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold', marginTop: 12 }}>依次给 5 张模板</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.65, marginTop: 8 }}>
                    模板由比赛方现场提供，word 或 excel 都可能，事先不知道结构
                </Text>
            </Box>
            <Box style={{ flex: 1 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, borderRadius: 17, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>3</Text>
                    </Box>
                    <Box style={{ flex: 1, height: 2, background: '#D6DCE5' }} />
                </Box>
                <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold', marginTop: 12 }}>每张跑一次并计时</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.65, marginTop: 8 }}>
                    每上传一张模板运行一次，由比赛方记录响应时间
                </Text>
            </Box>
            <Box style={{ flex: 1 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, borderRadius: 17, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>4</Text>
                    </Box>
                    <Box style={{ flex: 1, height: 2, background: '#D6DCE5' }} />
                </Box>
                <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold', marginTop: 12 }}>与样例表比对</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.65, marginTop: 8 }}>
                    填写结果与样例表格逐格对比，计算准确率
                </Text>
            </Box>
            <Box style={{ flex: 1 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 34, height: 34, borderRadius: 17, background: '#0E3F8C', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>5</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold', marginTop: 12 }}>算两张平均分</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.65, marginTop: 8 }}>
                    5 张填完，计算平均准确率与平均响应时间
                </Text>
            </Box>
        </Box>
    </Box>

    {/* 两条红线 */}
    <Box style={{ position: 'absolute', top: 400, left: 40, width: 1200, flexDirection: 'row', gap: 16 }}>
        <Box style={{ flex: 1, background: '#FDECEA', border: '1px solid #F0C4BF', padding: '22px 26px' }}>
            <Text style={{ fontSize: 14, color: '#B04A45', fontWeight: 'bold', letterSpacing: 1 }}>红线一</Text>
            <Text style={{ fontSize: 44, color: '#0E3F8C', fontWeight: 'bold', marginTop: 4 }}>≥ 80%</Text>
            <Text style={{ fontSize: 17, color: '#1A2230', marginTop: 6 }}>每一张表的准确率，不是平均后达标</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FDECEA', border: '1px solid #F0C4BF', padding: '22px 26px' }}>
            <Text style={{ fontSize: 14, color: '#B04A45', fontWeight: 'bold', letterSpacing: 1 }}>红线二</Text>
            <Text style={{ fontSize: 44, color: '#0E3F8C', fontWeight: 'bold', marginTop: 4 }}>≤ 90 s</Text>
            <Text style={{ fontSize: 17, color: '#1A2230', marginTop: 6 }}>每个文档的响应时间上限</Text>
        </Box>
        <Box style={{ flex: 1.4, background: '#F0F5FC', border: '1px solid #C9D8EC', padding: '22px 26px' }}>
            <Text style={{ fontSize: 17, color: '#1A2230', fontWeight: 'bold' }}>评分规则</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7, marginTop: 8 }}>
                平均准确率差 2% 以上 → 准确率定胜负；差 2% 以内 → 再比响应时间。所以"又快又准"不是口号，是两段式评分。
            </Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 52, width: 1200, background: '#F7F9FC', border: '1px solid #E5E7EB', padding: '14px 20px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 16, color: '#1A2230', fontWeight: 'bold' }}>这套流程我们完整仿真过 3 轮</Text>
        <Text style={{ fontSize: 15, color: '#4A5568' }}>16 份规格样本 ｜ Excel 五表连测 ｜ Word 五表连测 ｜ 大文档压测</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 40, bottom: 20, width: 1200, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>A-23 基于大语言模型的文档理解与多源数据融合系统</Text>
        <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>07 / 22</Text>
    </Box>
</Slide>
