<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', left: 90, top: 58, width: 800 }}>
        <Text style={{ fontSize: 30, color: '#1F1F1F', fontWeight: 'bold' }}>界面二：批量识别</Text>
        <Text style={{ fontSize: 17, color: '#6E6E6E', marginTop: 10 }}>勾几份文档，选要抽哪几条线，点一下就开始跑</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 950, top: 64, width: 240 }}>
        <Text style={{ fontSize: 13, color: '#9A9A9A', textAlign: 'right' }}>本机截图 · 10 月 13 日</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 152 }}>
        <Image src='assets/ui-recognize-crop.png' style={{ width: 700, height: 500, objectFit: 'cover', border: '1px solid #E2E2E2' }} />
    </Box>

    <Box style={{ position: 'absolute', left: 830, top: 158, width: 356 }}>
        <Text style={{ fontSize: 13, color: '#8A3B2A' }}>这一页能做什么</Text>

        <Box style={{ flexDirection: 'row', marginTop: 20 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>一次勾一批</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>左边列表勾几份就处理几份，不用一份一份上传</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>三条线分开跑</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>文档画像、七类实体、指定字段，可以只选一条，也可以一起跑</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>提交就先返回</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>不等结果，先给一个任务号，页面自己轮询进度</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>结果直接进库</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>不用导出表格再看，跑完就写进 MySQL，五张表分开存</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>每条都能回查</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>结果带原文摘抄和位置，点开能对上是哪一段</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 1120, top: 678, width: 70 }}>
        <Text style={{ fontSize: 12, color: '#BFBFBF', textAlign: 'right' }}>7 / 12</Text>
    </Box>
</Slide>
