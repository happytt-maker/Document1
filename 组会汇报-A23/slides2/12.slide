<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', left: 90, top: 56, width: 1080 }}>
        <Text style={{ fontSize: 30, color: '#1F1F1F', fontWeight: 'bold' }}>想请老师定三件事</Text>
        <Box style={{ width: 56, height: 3, background: '#8A3B2A', marginTop: 16 }} />
        <Text style={{ fontSize: 15, color: '#7A7A7A', marginTop: 16 }}>每个都写了现在卡在哪，老师可以直接给判断。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 196, width: 1080 }}>
        <Box style={{ flexDirection: 'row' }}>
            <Text style={{ fontSize: 15, color: '#B0B0B0', width: 34, marginTop: 6 }}>1</Text>
            <Text style={{ fontSize: 22, color: '#1F1F1F', fontWeight: 'bold', width: 1020 }}>先补通用性，还是先换真实数据？</Text>
        </Box>
        <Box style={{ flexDirection: 'row', marginTop: 10 }}>
            <Text style={{ fontSize: 14, color: '#9A9A9A', width: 44, marginTop: 4 }}>现状</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 990, lineHeight: 1.7 }}>换行业要重定实体、字段、别名表，现在只在合同这一类上试过。</Text>
        </Box>
        <Box style={{ flexDirection: 'row', marginTop: 6 }}>
            <Text style={{ fontSize: 14, color: '#8A3B2A', width: 44, marginTop: 4 }}>想问</Text>
            <Text style={{ fontSize: 17, color: '#2B2B2B', width: 990, lineHeight: 1.7 }}>是不是先拿一份别行业的真实文档试一遍，再定方向？我倾向先补通用性，但怕走偏。</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 330, width: 1080 }}>
        <Box style={{ flexDirection: 'row' }}>
            <Text style={{ fontSize: 15, color: '#B0B0B0', width: 34, marginTop: 6 }}>2</Text>
            <Text style={{ fontSize: 22, color: '#1F1F1F', fontWeight: 'bold', width: 1020 }}>明年参赛，创新点往哪个方向立？</Text>
        </Box>
        <Box style={{ flexDirection: 'row', marginTop: 10 }}>
            <Text style={{ fontSize: 14, color: '#9A9A9A', width: 44, marginTop: 4 }}>现状</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 990, lineHeight: 1.7 }}>流程跑通了，但技术上还是工程拼装，没有明显的方法创新。</Text>
        </Box>
        <Box style={{ flexDirection: 'row', marginTop: 6 }}>
            <Text style={{ fontSize: 14, color: '#8A3B2A', width: 44, marginTop: 4 }}>想问</Text>
            <Text style={{ fontSize: 17, color: '#2B2B2B', width: 990, lineHeight: 1.7 }}>语义匹配、表头自适应、历史填写做参照——哪个更值得投？还是都不够？</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 464, width: 1080 }}>
        <Box style={{ flexDirection: 'row' }}>
            <Text style={{ fontSize: 15, color: '#B0B0B0', width: 34, marginTop: 6 }}>3</Text>
            <Text style={{ fontSize: 22, color: '#1F1F1F', fontWeight: 'bold', width: 1020 }}>真实文档和标注规范，能借到吗？</Text>
        </Box>
        <Box style={{ flexDirection: 'row', marginTop: 10 }}>
            <Text style={{ fontSize: 14, color: '#9A9A9A', width: 44, marginTop: 4 }}>现状</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 990, lineHeight: 1.7 }}>16 份文档、5 张模板都是我自己造的，答案也是我自己标的。</Text>
        </Box>
        <Box style={{ flexDirection: 'row', marginTop: 6 }}>
            <Text style={{ fontSize: 14, color: '#8A3B2A', width: 44, marginTop: 4 }}>想问</Text>
            <Text style={{ fontSize: 17, color: '#2B2B2B', width: 990, lineHeight: 1.7 }}>实验室有没有脱敏的行业文档可以先用？标注有没有现成的规范？</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 90, bottom: 66, width: 1080, borderTop: '1px solid #E2E2E2', paddingTop: 16 }}>
        <Text style={{ fontSize: 15, color: '#5A5A5A', lineHeight: 1.8 }}>下次组会打算汇报：通用性补到哪一步，真实文档拿到了多少。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, bottom: 28, width: 1080 }}>
        <Text style={{ fontSize: 14, color: '#9A9A9A' }}>谢谢老师，也谢谢各位同学。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 1120, top: 678, width: 70 }}>
        <Text style={{ fontSize: 12, color: '#BFBFBF', textAlign: 'right' }}>12 / 12</Text>
    </Box>
</Slide>
