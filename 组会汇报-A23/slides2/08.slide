<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', left: 90, top: 58, width: 800 }}>
        <Text style={{ fontSize: 30, color: '#1F1F1F', fontWeight: 'bold' }}>界面三：填表下载</Text>
        <Text style={{ fontSize: 17, color: '#6E6E6E', marginTop: 10 }}>选一张模板，跑完下载填好的表，模板本身不动</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 950, top: 64, width: 240 }}>
        <Text style={{ fontSize: 13, color: '#9A9A9A', textAlign: 'right' }}>本机截图 · 10 月 13 日</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 152 }}>
        <Image src='assets/ui-fill-crop.png' style={{ width: 700, height: 500, objectFit: 'cover', border: '1px solid #E2E2E2' }} />
    </Box>

    <Box style={{ position: 'absolute', left: 830, top: 158, width: 356 }}>
        <Text style={{ fontSize: 13, color: '#8A3B2A' }}>这一页能做什么</Text>

        <Box style={{ flexDirection: 'row', marginTop: 20 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>Word、Excel 都认</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>选一张模板就跑，两种格式都支持，模板本身不动</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>表头自动读</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>先找表头行和待填区域，不用手工指定从第几行填</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>只写值，不改样式</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>字体、边框、合并单元格都保留，另存一个新文件</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>找不到就留空</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>不猜、不编，宁可空着等人补，错填比漏填更难查</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>时间在限内</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>一般 10 到 40 秒，最长一单 44 秒，赛题限的是 90 秒</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 1120, top: 678, width: 70 }}>
        <Text style={{ fontSize: 12, color: '#BFBFBF', textAlign: 'right' }}>8 / 12</Text>
    </Box>
</Slide>
