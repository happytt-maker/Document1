<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', left: 90, top: 58, width: 800 }}>
        <Text style={{ fontSize: 30, color: '#1F1F1F', fontWeight: 'bold' }}>界面一：直接说人话</Text>
        <Text style={{ fontSize: 17, color: '#6E6E6E', marginTop: 10 }}>不用记按钮在哪，把要做的事说清楚就行</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 152 }}>
        <Image src='assets/ui-home.png' style={{ width: 700, height: 437, objectFit: 'cover', border: '1px solid #E2E2E2' }} />
    </Box>

    <Box style={{ position: 'absolute', left: 830, top: 158, width: 356 }}>
        <Text style={{ fontSize: 13, color: '#8A3B2A' }}>这一页能做什么</Text>

        <Box style={{ flexDirection: 'row', marginTop: 20 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>一句话就是一条指令</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>不用找按钮、不用填表单，说清楚要改什么就行</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>能接着上一句说</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>第二句里的「它」指上一份文档，不用重复说文件名</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>四类操作都覆盖</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>改字、改格式、调版式，也能把内容抽成一张清单</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>四种格式都能改</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>Word、Excel、Markdown、纯文本，写完另存新文件，原件不动</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 15 }}>
            <Box style={{ width: 4, height: 4, background: '#8A3B2A', marginTop: 10, marginRight: 11 }} />
            <Box style={{ width: 330 }}>
                <Text style={{ fontSize: 15, color: '#1F1F1F', fontWeight: 'bold', width: 330 }}>每条操作都有记录</Text>
                <Text style={{ fontSize: 14, color: '#6E6E6E', lineHeight: 1.6, marginTop: 3, width: 330 }}>右边历史带耗时，最慢一条 1.5 秒，出问题能回头查</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 950, top: 64, width: 240 }}>
        <Text style={{ fontSize: 13, color: '#9A9A9A', textAlign: 'right' }}>本机截图 · 10 月 13 日</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 1120, top: 678, width: 70 }}>
        <Text style={{ fontSize: 12, color: '#BFBFBF', textAlign: 'right' }}>6 / 12</Text>
    </Box>
</Slide>
