<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', left: 90, top: 60, width: 1100 }}>
        <Text style={{ fontSize: 30, color: '#1F1F1F', fontWeight: 'bold' }}>这道题还能怎么变</Text>
        <Text style={{ fontSize: 17, color: '#6E6E6E', marginTop: 10 }}>明年赛题出来，先看它落在哪个维度，再决定改哪里、改多少</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 186, width: 1100 }}>
        <Box style={{ flexDirection: 'row', borderBottom: '1px solid #D8D8D8', paddingBottom: 14 }}>
            <Text style={{ fontSize: 14, color: '#8A8A8A', width: 140 }}>变的方向</Text>
            <Text style={{ fontSize: 14, color: '#8A8A8A', width: 410 }}>换成什么</Text>
            <Text style={{ fontSize: 14, color: '#8A8A8A', width: 420 }}>要动的地方</Text>
            <Text style={{ fontSize: 14, color: '#8A8A8A', width: 100 }}>改动量</Text>
        </Box>

        <Box style={{ flexDirection: 'row', borderBottom: '1px solid #EEEEEE', paddingTop: 32, paddingBottom: 32 }}>
            <Text style={{ fontSize: 17, color: '#1F1F1F', fontWeight: 'bold', width: 140 }}>换行业</Text>
            <Text style={{ fontSize: 16, color: '#2B2B2B', width: 410, lineHeight: 1.6 }}>合同台账 → 病历首页、招标文件、科研文献等</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 420, lineHeight: 1.6 }}>字段表、术语和别名，都在配置里</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 100 }}>小</Text>
        </Box>

        <Box style={{ flexDirection: 'row', borderBottom: '1px solid #EEEEEE', paddingTop: 32, paddingBottom: 32 }}>
            <Text style={{ fontSize: 17, color: '#1F1F1F', fontWeight: 'bold', width: 140 }}>换输入</Text>
            <Text style={{ fontSize: 16, color: '#2B2B2B', width: 410, lineHeight: 1.6 }}>电子文档 → 扫描件、手机拍照、带水印的 PDF</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 420, lineHeight: 1.6 }}>最前面加一层 OCR 和错字纠正</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 100 }}>中</Text>
        </Box>

        <Box style={{ flexDirection: 'row', paddingTop: 32, paddingBottom: 32 }}>
            <Text style={{ fontSize: 17, color: '#1F1F1F', fontWeight: 'bold', width: 140 }}>换输出</Text>
            <Text style={{ fontSize: 16, color: '#2B2B2B', width: 410, lineHeight: 1.6 }}>填一张表 → 建领域知识库、做成问答</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 420, lineHeight: 1.6 }}>输出层换接口，提取和入库不动</Text>
            <Text style={{ fontSize: 16, color: '#5A5A5A', width: 100 }}>小</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 566, width: 1100, height: 104, background: '#F6F6F4' }} />
    <Box style={{ position: 'absolute', left: 114, top: 584, width: 1060 }}>
        <Text style={{ fontSize: 21, color: '#1F1F1F' }}>简单说：换行业只改配置，换输入加一层，换输出只换接口。</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 114, top: 624, width: 1060 }}>
        <Text style={{ fontSize: 17, color: '#5A5A5A' }}>底下读取、定位、判值、写回这四步是核心，不需要重写。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 1120, top: 678, width: 70 }}>
        <Text style={{ fontSize: 12, color: '#BFBFBF', textAlign: 'right' }}>3 / 12</Text>
    </Box>
</Slide>
