<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', left: 90, top: 60, width: 1100 }}>
        <Text style={{ fontSize: 30, color: '#1F1F1F', fontWeight: 'bold' }}>三个模块，现在都能用了</Text>
        <Text style={{ fontSize: 16, color: '#6E6E6E', marginTop: 10 }}>在网页操作台上点一下就行，也可以写代码调</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 208, width: 1100, flexDirection: 'row' }}>

        <Box style={{ width: 330, marginRight: 55, borderTop: '2px solid #1F1F1F', paddingTop: 20 }}>
            <Text style={{ fontSize: 14, color: '#8A3B2A' }}>模块一</Text>
            <Text style={{ fontSize: 27, color: '#1F1F1F', fontWeight: 'bold', marginTop: 10 }}>文档智能操作</Text>
            <Text style={{ fontSize: 20, color: '#3A3A3A', lineHeight: 1.8, marginTop: 24 }}>
                说一句话，它就照着改。
            </Text>
            <Text style={{ fontSize: 18, color: '#5A5A5A', lineHeight: 2.2, marginTop: 24 }}>
                · 改字、改格式、调版式、抽内容{'\n'}
                · Word / Excel / Markdown 都行
            </Text>
            <Text style={{ fontSize: 16, color: '#8A8A8A', marginTop: 26 }}>
                比如：「把标题居中并加粗」
            </Text>
        </Box>

        <Box style={{ width: 330, marginRight: 55, borderTop: '2px solid #1F1F1F', paddingTop: 20 }}>
            <Text style={{ fontSize: 14, color: '#8A3B2A' }}>模块二</Text>
            <Text style={{ fontSize: 27, color: '#1F1F1F', fontWeight: 'bold', marginTop: 10 }}>信息提取与入库</Text>
            <Text style={{ fontSize: 20, color: '#3A3A3A', lineHeight: 1.8, marginTop: 24 }}>
                读一份文档，把关键信息挑出来。
            </Text>
            <Text style={{ fontSize: 18, color: '#5A5A5A', lineHeight: 2.2, marginTop: 24 }}>
                · 画像、实体、字段，三类都能抽{'\n'}
                · 每条都带原文出处，能核对
            </Text>
            <Text style={{ fontSize: 16, color: '#8A8A8A', marginTop: 26 }}>
                比如：「识别这份纪要里的实体」
            </Text>
        </Box>

        <Box style={{ width: 330, borderTop: '2px solid #1F1F1F', paddingTop: 20 }}>
            <Text style={{ fontSize: 14, color: '#8A3B2A' }}>模块三</Text>
            <Text style={{ fontSize: 27, color: '#1F1F1F', fontWeight: 'bold', marginTop: 10 }}>表格自动填写</Text>
            <Text style={{ fontSize: 20, color: '#3A3A3A', lineHeight: 1.8, marginTop: 24 }}>
                给一张空表，它自己去文档里找值。
            </Text>
            <Text style={{ fontSize: 18, color: '#5A5A5A', lineHeight: 2.2, marginTop: 24 }}>
                · Word、Excel 模板都能填{'\n'}
                · 找不到就留空，不瞎猜
            </Text>
            <Text style={{ fontSize: 16, color: '#8A8A8A', marginTop: 26 }}>
                比如：21 格台账，从 13 份文档里找值
            </Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 90, bottom: 66, width: 1100, flexDirection: 'row' }}>
        <Box style={{ width: 3, background: '#8A3B2A', marginRight: 14 }} />
        <Text style={{ fontSize: 16, color: '#5A5A5A', lineHeight: 1.7, width: 1060 }}>
            三个模块用的是同一套底层能力；现在还不稳的，是换一种文档、换一个行业的时候。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 1120, top: 678, width: 70 }}>
        <Text style={{ fontSize: 12, color: '#BFBFBF', textAlign: 'right' }}>5 / 12</Text>
    </Box>
</Slide>
