<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', left: 90, top: 58, width: 1100 }}>
        <Text style={{ fontSize: 28, color: '#1F1F1F', fontWeight: 'bold' }}>整体怎么走：一条五段的流水线</Text>
        <Text style={{ fontSize: 15, color: '#6E6E6E', marginTop: 8 }}>输入是格式不一的文档，输出是一张格式没变、单元格已经填好的表</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 158, width: 1100, flexDirection: 'row', alignItems: 'flex-start' }}>
        <Box style={{ width: 180 }}>
            <Text style={{ fontSize: 12, color: '#A0A0A0' }}>01</Text>
            <Text style={{ fontSize: 19, color: '#1F1F1F', fontWeight: 'bold', marginTop: 6 }}>读取</Text>
            <Text style={{ fontSize: 13, color: '#6A6A6A', lineHeight: 1.7, marginTop: 6 }}>docx / xlsx /{'\n'}md / txt 统一解析</Text>
        </Box>
        <Text style={{ fontSize: 22, color: '#B8B8B8', width: 30, textAlign: 'center', marginTop: 20 }}>→</Text>
        <Box style={{ width: 180 }}>
            <Text style={{ fontSize: 12, color: '#A0A0A0' }}>02</Text>
            <Text style={{ fontSize: 19, color: '#1F1F1F', fontWeight: 'bold', marginTop: 6 }}>分块定位</Text>
            <Text style={{ fontSize: 13, color: '#6A6A6A', lineHeight: 1.7, marginTop: 6 }}>每块带行号、段号{'\n'}或单元格坐标</Text>
        </Box>
        <Text style={{ fontSize: 22, color: '#B8B8B8', width: 30, textAlign: 'center', marginTop: 20 }}>→</Text>
        <Box style={{ width: 180 }}>
            <Text style={{ fontSize: 12, color: '#A0A0A0' }}>03</Text>
            <Text style={{ fontSize: 19, color: '#1F1F1F', fontWeight: 'bold', marginTop: 6 }}>读模板</Text>
            <Text style={{ fontSize: 13, color: '#6A6A6A', lineHeight: 1.7, marginTop: 6 }}>自动找表头行{'\n'}和待填区域</Text>
        </Box>
        <Text style={{ fontSize: 22, color: '#B8B8B8', width: 30, textAlign: 'center', marginTop: 20 }}>→</Text>
        <Box style={{ width: 190 }}>
            <Text style={{ fontSize: 12, color: '#8A3B2A' }}>04　大模型在这里</Text>
            <Text style={{ fontSize: 19, color: '#8A3B2A', fontWeight: 'bold', marginTop: 6 }}>判值</Text>
            <Text style={{ fontSize: 13, color: '#6A6A6A', lineHeight: 1.7, marginTop: 6 }}>先筛候选段落，{'\n'}再让模型给值</Text>
        </Box>
        <Text style={{ fontSize: 22, color: '#B8B8B8', width: 30, textAlign: 'center', marginTop: 20 }}>→</Text>
        <Box style={{ width: 180 }}>
            <Text style={{ fontSize: 12, color: '#A0A0A0' }}>05</Text>
            <Text style={{ fontSize: 19, color: '#1F1F1F', fontWeight: 'bold', marginTop: 6 }}>写回</Text>
            <Text style={{ fontSize: 13, color: '#6A6A6A', lineHeight: 1.7, marginTop: 6 }}>只写值，不动样式，{'\n'}输出新文件</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 352, width: 1100 }}>
        <Text style={{ fontSize: 14, color: '#8A8A8A' }}>用到的技术</Text>

        <Box style={{ flexDirection: 'row', borderBottom: '1px solid #E2E2E2', paddingTop: 12, paddingBottom: 11 }}>
            <Text style={{ fontSize: 14, color: '#8A8A8A', width: 150 }}>环节</Text>
            <Text style={{ fontSize: 14, color: '#8A8A8A', width: 300 }}>用什么</Text>
            <Text style={{ fontSize: 14, color: '#8A8A8A', flex: 1 }}>为什么</Text>
        </Box>
        <Box style={{ flexDirection: 'row', borderBottom: '1px solid #EEEEEE', paddingTop: 15, paddingBottom: 15 }}>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 150 }}>文档读写</Text>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 300 }}>python-docx / openpyxl</Text>
            <Text style={{ fontSize: 15, color: '#5A5A5A', flex: 1 }}>能拿到 run 级格式和合并单元格，保住原样式</Text>
        </Box>
        <Box style={{ flexDirection: 'row', borderBottom: '1px solid #EEEEEE', paddingTop: 15, paddingBottom: 15 }}>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 150 }}>语义理解</Text>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 300 }}>DeepSeek API（大模型）</Text>
            <Text style={{ fontSize: 15, color: '#5A5A5A', flex: 1 }}>只让它判断「这个格子该填什么」，不让它定位</Text>
        </Box>
        <Box style={{ flexDirection: 'row', borderBottom: '1px solid #EEEEEE', paddingTop: 15, paddingBottom: 15 }}>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 150 }}>对外服务</Text>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 300 }}>FastAPI + 线程池任务</Text>
            <Text style={{ fontSize: 15, color: '#5A5A5A', flex: 1 }}>识别和填表耗时较长，改成提交后轮询</Text>
        </Box>
        <Box style={{ flexDirection: 'row', borderBottom: '1px solid #EEEEEE', paddingTop: 15, paddingBottom: 15 }}>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 150 }}>数据存储</Text>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 300 }}>MySQL（文档 / 实体 / 画像 / 字段）</Text>
            <Text style={{ fontSize: 15, color: '#5A5A5A', flex: 1 }}>每条记录留存原文摘抄和位置，可以反查</Text>
        </Box>
        <Box style={{ flexDirection: 'row', paddingTop: 15 }}>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 150 }}>质量校验</Text>
            <Text style={{ fontSize: 15, color: '#2B2B2B', width: 300 }}>纯 Python，正则 + 原文回查</Text>
            <Text style={{ fontSize: 15, color: '#5A5A5A', flex: 1 }}>不拿模型给自己打分，结果才可信</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 1120, top: 678, width: 70 }}>
        <Text style={{ fontSize: 12, color: '#BFBFBF', textAlign: 'right' }}>4 / 12</Text>
    </Box>
</Slide>
