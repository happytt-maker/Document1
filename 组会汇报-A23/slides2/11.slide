<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', left: 90, top: 50, width: 1100 }}>
        <Text style={{ fontSize: 28, color: '#1F1F1F', fontWeight: 'bold' }}>接下来怎么走</Text>
        <Text style={{ fontSize: 15, color: '#6E6E6E', marginTop: 8 }}>先把「哪些行业能用」说清楚，再说接下来补什么</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 132, width: 1100 }}>
        <Text style={{ fontSize: 18, color: '#1F1F1F', fontWeight: 'bold' }}>现在这套东西，通用到什么程度</Text>

        <Box style={{ flexDirection: 'row', marginTop: 20 }}>
            <Text style={{ fontSize: 17, color: '#8A3B2A', fontWeight: 'bold', width: 170 }}>代码不用改</Text>
            <Text style={{ fontSize: 17, color: '#3A3A3A', width: 900, lineHeight: 1.6 }}>读文档、找位置、写回、保格式——这四层跟行业无关，Word、Excel 都能跑</Text>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 18 }}>
            <Text style={{ fontSize: 17, color: '#3A3A3A', fontWeight: 'bold', width: 170 }}>要重配一遍</Text>
            <Text style={{ fontSize: 17, color: '#3A3A3A', width: 900, lineHeight: 1.6 }}>换行业得重定实体类型、字段清单、别名表、模板定义。估一两天，但只在合同这一类上试过</Text>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 18 }}>
            <Text style={{ fontSize: 17, color: '#9A9A9A', fontWeight: 'bold', width: 170 }}>现在还做不了</Text>
            <Text style={{ fontSize: 17, color: '#3A3A3A', width: 900, lineHeight: 1.6 }}>扫描件拍照、多层和斜线表头、跨页续表、手写——输入一乱就接不住</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 312, width: 1100, height: 2, background: '#1F1F1F' }} />

    <Box style={{ position: 'absolute', left: 90, top: 332, width: 1100 }}>
        <Text style={{ fontSize: 18, color: '#1F1F1F', fontWeight: 'bold' }}>所以接下来主要补三件事</Text>

        <Box style={{ flexDirection: 'row', marginTop: 18 }}>
            <Box style={{ width: 5, height: 5, background: '#8A3B2A', marginTop: 11, marginRight: 13 }} />
            <Text style={{ fontSize: 16, color: '#3A3A3A', width: 1060, lineHeight: 1.6 }}>字段匹配改成语义：拿向量找最接近的说法，别名表退成兜底，换个行业能少配一半</Text>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 14 }}>
            <Box style={{ width: 5, height: 5, background: '#8A3B2A', marginTop: 11, marginRight: 13 }} />
            <Text style={{ fontSize: 16, color: '#3A3A3A', width: 1060, lineHeight: 1.6 }}>表头识别做成自适应：多行表头、合并单元格、跨页续表都能认，输入这一侧先接住</Text>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 14 }}>
            <Box style={{ width: 5, height: 5, background: '#8A3B2A', marginTop: 11, marginRight: 13 }} />
            <Text style={{ fontSize: 16, color: '#3A3A3A', width: 1060, lineHeight: 1.6 }}>拿历史填写当参照：填新表前先查库里同类表是怎么填的，这条是把手上的库真正用起来</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 90, top: 542, width: 1100, borderTop: '1px solid #E2E2E2', paddingTop: 16 }}>
        <Text style={{ fontSize: 15, color: '#5A5A5A', lineHeight: 1.7 }}>时间上：10–12 月补这三件　→　明年上半年换真实数据、补部署　→　2027 年 9 月接新赛题</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 90, bottom: 58, width: 1040, borderLeft: '3px solid #8A3B2A', paddingLeft: 16 }}>
        <Text style={{ fontSize: 16, color: '#2B2B2B', lineHeight: 1.7 }}>Agent 我暂时不打算硬上——填表要求每个值都能指回原文，多步自主反而不好核。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 1120, top: 678, width: 70 }}>
        <Text style={{ fontSize: 12, color: '#BFBFBF', textAlign: 'right' }}>11 / 12</Text>
    </Box>
</Slide>
