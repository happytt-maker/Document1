    {
      "file": "财务报销管理规定.txt",
      "type": "txt",
      "encoding": "utf-8-sig",
      "line_count": 14,
      "block_count": 4,
      "blocks": [
        {
          "file": "财务报销管理规定.txt",
          "type": "txt",
          "text": "星锐科技有限公司财务报销管理规定\n（2025 年修订版）",
          "locator": {
            "line_start": 1,
            "line_end": 2
          }
        },
        {
          "file": "财务报销管理规定.txt",
          "type": "txt",
          "text": "第一章 总则\n第一条 为规范费用报销流程、加强费用管控，制定本规定。\n第二条 报销范围包括差旅费、办公费、采购费、招待费等。",
          "locator": {
            "line_start": 4,
            "line_end": 6
          }
        },
        {
          "file": "财务报销管理规定.txt",
          "type": "txt",
          "text": "第二章 报销流程\n第三条 报销单号由财务系统自动生成，格式为 BX-年份-流水号。\n第四条 单笔报销金额超过 5000 元的，须报总经理审批。\n第五条 报销人应在费用发生后 10 个工作日内提交报销单，逾期须附情况说明。",
          "locator": {
            "line_start": 8,
            "line_end": 11
          }
        },
        {
          "file": "财务报销管理规定.txt",
          "type": "txt",
          "text": "第三章 附则\n第六条 本规定由财务部负责解释。",
          "locator": {
            "line_start": 13,
            "line_end": 14
          }
        }
      ]
    },
