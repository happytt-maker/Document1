# ============================================================
# A-23 智能文档助手 · .gitignore
# 原则：源码、测试数据、文档、验收记录进仓库；
#       大件（模型/安装包）、含口令的配置、运行产物一律不进。
# ============================================================

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---------- 体积大、可在本机重建（见 README「环境重建」）----------
agent/models/
agent/.wheels/
*.whl
# 文档解析池：由 源文档 + 导入文档 现场生成，随数据增长到上百 MB，不进仓库
doc_reader/output.json
测试数据/压测-大文档/源文档/
压测-大文档/结果/大池-output.json

# ---------- 含口令的本地配置：绝对不要提交 ----------
agent/db_config.json
agent/llm_key.txt
secrets.local.json
.env
.env.*

# ---------- 运行产物 ----------
agent/输出/
agent/digital/cache/
测试数据/模板上传/
# 操作台的运行态：任务产物（可达数百 MB）、现场解析缓存、用户头像、导入的文档
agent/jobs/
agent/.cache/
agent/avatars/
导入文档/
# 真机验收留下的浏览器 profile 与临时输出
收尾对照/_*
# 历史填写存档：是"这台机器填过哪些表"的运行状态，换机器应当重新积累。
# 结构说明见 README「历史填写参照」；MySQL 镜像同理不入库（表由代码自动建）。
matcher/历史填写.json
*.log
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------- 备份与工具缓存 ----------
*.bak
*.bak-*
备份-*/
.备份-*/
组会汇报-A23/preview/
组会汇报-A23/preview-5min/
.slidep/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时探针脚本 ----------
_tmp*
_t.txt

# ---------- 语义模型（91MB，可在本机重建：python agent/下载语义模型.py）----------
/models/
/agent/语义缓存/
