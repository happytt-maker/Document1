# ============================================================
# A-23 智能文档助手 · .gitignore
# 原则：源码、测试数据、文档、验收记录进仓库；
#       大件（模型/安装包）、含口令的配置、运行产物一律不进。
# ============================================================

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---------- 体积大、可在本机重建（见 README「环境重建」）----------
agent/models/
agent/.wheels/
*.whl
测试数据/压测-大文档/源文档/
压测-大文档/结果/大池-output.json

# ---------- 含口令的本地配置：绝对不要提交 ----------
agent/db_config.json
agent/llm_key.txt
secrets.local.json
.env
.env.*

# ---------- 运行产物 ----------
agent/输出/
agent/digital/cache/
测试数据/模板上传/
*.log
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------- 备份与工具缓存 ----------
*.bak
*.bak-*
备份-*/
.备份-*/
组会汇报-A23/preview/
组会汇报-A23/preview-5min/
.slidep/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时探针脚本 ----------
_tmp*
